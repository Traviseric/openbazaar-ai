# ===================================
# OpenBazaar AI Configuration
# ===================================
# Copy this file to .env and fill in your values
# Get help: https://github.com/TravisEric/openbazaar-ai/blob/main/PRODUCTION_SETUP.md

# ===================================
# Server Configuration
# ===================================
PORT=3001
NODE_ENV=development

# ===================================
# Site Configuration
# ===================================
SITE_URL=http://localhost:3001
STORE_NAME=My Bookstore
ADMIN_EMAIL=admin@example.com

# ===================================
# Stripe Payment Processing
# ===================================
# Get your keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY_HERE

# Get webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Options: test, live (use 'test' for development)
STRIPE_MODE=test

# ===================================
# Email Configuration
# ===================================
# Choose ONE of these email providers:

# --- Option 1: Gmail (Easy Setup) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password
EMAIL_FROM=Your Store Name <your-email@gmail.com>

# --- Option 2: SendGrid (Recommended for Production) ---
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=apikey
# EMAIL_PASS=SG.your-sendgrid-api-key
# EMAIL_FROM=Your Store Name <verified@yourdomain.com>

# --- Option 3: Custom SMTP ---
# EMAIL_HOST=mail.yourdomain.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=smtp-username
# EMAIL_PASS=smtp-password
# EMAIL_FROM=Your Store Name <noreply@yourdomain.com>

# ===================================
# Database Configuration
# ===================================
# Supabase/Postgres runtime (production — recommended)
# Get the Postgres URI from:
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# SUPABASE_DB_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#
# If DATABASE_URL/SUPABASE_DB_URL is set, backend runtime uses Postgres.
# If neither is set, runtime falls back to local SQLite DATABASE_PATH.

# Supabase API keys (used for Supabase APIs/storage/auth integrations)
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SQLite (local development fallback)
# DATABASE_PATH=./database/marketplace.db

# ===================================
# Security Configuration
# ===================================
# Generate random strings for these (or let setup wizard create them)
JWT_SECRET=your-random-64-character-secret-string-here-make-it-very-long-and-random
SESSION_SECRET=your-random-32-character-session-secret-here

# ===================================
# Authentication Configuration
# ===================================
# Choose authentication provider: 'local' (default) or 'teneo-auth'
AUTH_PROVIDER=local

# --- Option 1: Local Auth (default) ---
# SQLite + magic links. Works out of the box, zero external deps.
MAGIC_LINK_EXPIRY_MINUTES=60

# --- Option 2: TENEO Auth SSO (OAuth 2.0 + PKCE) ---
# Unified auth across the TENEO ecosystem (BCG, AIBridge, FormForge, etc.)
# Set AUTH_PROVIDER=teneo-auth and configure below:
#
# TENEO_AUTH_URL=https://auth.teneo.io
# TENEO_CLIENT_ID=openbazaar-ai
# TENEO_CALLBACK_URL=https://marketplace.teneo.io/api/auth/callback
# TENEO_SERVICE_KEY=your-service-api-key-for-server-to-server-calls
#
# TENEO_CLIENT_SECRET is OPTIONAL for the official marketplace.
# The teneo-auth token endpoint skips secret validation for first-party
# clients using PKCE (code_verifier is sufficient). Only set this if
# you're running a third-party fork without first-party status:
# TENEO_CLIENT_SECRET=your-client-secret-here

# --- Option 3: Nostr Auth (planned) ---
# Connects to arxmint payment rails. Not yet implemented.
# NOSTR_RELAY_URL=wss://relay.teneo.io

# ===================================
# Crypto Payment Configuration
# ===================================
# Static wallet addresses for manual crypto payments (fallback when BTCPay not configured)
BTC_ADDRESS=YOUR_BITCOIN_ADDRESS_HERE
LIGHTNING_ADDRESS=YOUR_LIGHTNING_ADDRESS_HERE
XMR_ADDRESS=YOUR_MONERO_ADDRESS_HERE

# --- ArxMint Payment Provider (Lightning/ecash checkout) ---
# ArxMint provides hosted Lightning checkout at arxmint.com/pay/{merchantId}
# Set these to enable "Pay with Lightning" on your storefront.
#
# ARXMINT_URL=https://arxmint.com
# ARXMINT_MERCHANT_ID=your-merchant-id
# ARXMINT_WEBHOOK_SECRET=shared-secret-for-webhook-verification
#
# How to get these values:
#   1. Sign up as a merchant at arxmint.com/merchants
#   2. Get your merchant ID from the merchant dashboard
#   3. Configure a webhook pointing to: https://yourdomain.com/api/storefront/fulfill
#   4. Set the shared webhook secret as ARXMINT_WEBHOOK_SECRET

# --- BTCPay Server (automated crypto verification) ---
# Set up a BTCPay Server instance (self-hosted or use voltpay.app / btcpay.swiss)
# then configure these to enable automated payment detection and instant fulfillment.
# Leave blank to use the manual wallet-address fallback flow.
#
# BTCPAY_URL=https://btcpay.yourdomain.com
# BTCPAY_API_KEY=your-store-level-api-key
# BTCPAY_STORE_ID=your-btcpay-store-id
# BTCPAY_WEBHOOK_SECRET=random-secret-shared-with-btcpay-webhook-config
#
# How to get these values:
#   1. Create a BTCPay Server account at https://mainnet.demo.btcpayserver.org
#   2. Create a store and note the Store ID from Settings > General
#   3. Generate an API key at Account > API Keys (select "Create invoice" permission)
#   4. Add a webhook in Store > Webhooks pointing to:
#      https://yourdomain.com/api/crypto/btcpay/webhook
#      Choose a random webhook secret and set it as BTCPAY_WEBHOOK_SECRET

# --- Printful POD fulfillment ---
# Multi-tenant: each merchant connects their own Printful store via dashboard.
# Credentials are stored AES-256-GCM encrypted in the database.
#
# REQUIRED for multi-tenant fulfillment:
# FULFILLMENT_ENCRYPTION_KEY=64-char-hex-string-for-encrypting-merchant-api-keys
#
# PUBLIC_URL is used to auto-register per-merchant Printful webhooks on connect.
# PUBLIC_URL=https://openbazaar.ai

# TE ecosystem service-key integration.
# TENEO_SERVICE_KEYS accepts comma-separated keys allowed to call /api/ai-invoke/*.
# TENEO_PRODUCTION_API_URL is the teneo-production API base used for fulfillment callbacks.
# TENEO_PRODUCTION_SERVICE_KEY is OpenBazaar's key for calling teneo-production.
# TENEO_SERVICE_KEYS=te_svc_teneo_production_<32_hex>
# TENEO_PRODUCTION_API_URL=https://api.teneo.io
# TENEO_PRODUCTION_SERVICE_KEY=te_svc_openbazaar_ai_<32_hex>
#
# Per-merchant webhook endpoints (auto-registered):
#   https://yourdomain.com/api/webhooks/printful/{merchantId}
#
# Legacy single-tenant mode (optional fallback for ArxMint Bazaar):
# PRINTFUL_API_KEY=your-printful-private-api-token
# PRINTFUL_STORE_ID=your-printful-store-id
# PRINTFUL_WEBHOOK_SECRET=shared-secret-for-printful-webhooks
# PRINTFUL_API_BASE=https://api.printful.com
#
# Legacy webhook endpoint:
#   https://yourdomain.com/api/webhooks/printful

# --- Lulu POD fulfillment (optional; for physical book dropship products) ---
# Configure when you want /api/storefront/fulfill to create Lulu print jobs.
#
# LULU_CLIENT_KEY=your-lulu-client-id
# LULU_CLIENT_SECRET=your-lulu-client-secret
# LULU_API_URL=https://api.sandbox.lulu.com
# LULU_WEBHOOK_SECRET=shared-secret-for-lulu-webhooks
#
# Lulu webhook endpoint:
#   https://yourdomain.com/api/lulu/webhook

# ===================================
# Feature Flags
# ===================================
ENABLE_EMAIL=true
ENABLE_ANALYTICS=true
ENABLE_WEBHOOKS=true

# ===================================
# Network Configuration (Optional)
# ===================================
# Your store's network information
STORE_ID=my-store
STORE_SPECIALTIES=fiction,mystery,thriller
STORE_OWNER=Your Name
STORE_CONTACT=contact@yourdomain.com

# ===================================
# Advanced Configuration (Optional)
# ===================================
# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File upload limits
MAX_FILE_SIZE=52428800
MAX_BOOKS_PER_BRAND=100

# Session configuration
SESSION_TIMEOUT=86400000

# CORS settings
CORS_ORIGIN=*

# ===================================
# Development Tools (Optional)
# ===================================
# Debugging
DEBUG=false
LOG_LEVEL=info

# Auto-reload
ENABLE_HOT_RELOAD=true

# ===================================
# Deployment Platform Variables
# ===================================
# These are often set automatically by hosting platforms

# Vercel
# VERCEL_URL (set automatically)

# Railway
# RAILWAY_STATIC_URL (set automatically)
# RAILWAY_PORT (set automatically)

# Render
# RENDER_EXTERNAL_URL (set automatically)

# Netlify
# URL (set automatically)

# ===================================
# Getting Started Checklist
# ===================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your Stripe keys (get from https://dashboard.stripe.com/apikeys)
# 3. Configure email (start with Gmail for testing)
# 4. Set your SITE_URL to your domain
# 5. Run setup wizard: npm run setup:wizard
# 6. Check everything: npm run pre-launch
# 7. Start selling: npm start

