#!/bin/sh
# Block committing private keys / PEM secrets. Keys belong in the vault or env,
# never in the repo. Enable with: git config core.hooksPath .githooks
if git diff --cached -U0 | grep -nE 'BEGIN [A-Z ]*PRIVATE KEY' >/dev/null 2>&1; then
  echo "ERROR: refusing to commit a PRIVATE KEY (PEM block detected in staged changes)." >&2
  echo "       Remove it; store secrets in the vault/env, not in the repo." >&2
  exit 1
fi
exit 0
