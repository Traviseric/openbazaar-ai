{
  "name": "openbazaar-ai",
  "version": "2.0.0",
  "description": "OpenBazaar.ai — The open marketplace for creators, freelancers, and agents.",
  "main": "marketplace/backend/server.js",
  "scripts": {
    "start": "node marketplace/backend/server.js",
    "dev": "nodemon marketplace/backend/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "register-node": "node marketplace/backend/scripts/register-node.js",
    "seed:appstore": "node marketplace/backend/scripts/seed-appstore.js",
    "db:init": "node marketplace/backend/database/init.js",
    "trademark:report": "node tools/trademark-filing.js --report",
    "trademark:prepare": "node tools/trademark-filing.js",
    "trademark:prepare:openbazaar": "node tools/trademark-filing.js --mark openbazaar-ai-wordmark",
    "trademark:dropoff:openbazaar": "node tools/trademark-filing.js --mark openbazaar-ai-wordmark"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/__tests__",
      "<rootDir>/marketplace/backend/__tests__"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "testTimeout": 10000,
    "modulePathIgnorePatterns": [
      "<rootDir>/marketplace/package.json"
    ],
    "moduleNameMapper": {
      "^stripe$": "<rootDir>/marketplace/backend/node_modules/stripe",
      "^axios$": "<rootDir>/node_modules/axios/dist/node/axios.cjs"
    }
  },
  "keywords": [
    "marketplace",
    "freelance",
    "gig-economy",
    "open-source",
    "bitcoin",
    "lightning",
    "ecash",
    "federation",
    "decentralized",
    "arxmint"
  ],
  "author": "Travis Eric",
  "license": "MIT",
  "homepage": "https://openbazaar.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Traviseric/openbazaar-ai.git"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "archiver": "^6.0.1",
    "axios": "^1.16.1",
    "bcrypt": "^5.1.1",
    "better-sqlite3": "^12.10.0",
    "body-parser": "^1.20.5",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^4.0.3",
    "csurf": "^1.11.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "nostr-tools": "^1.17.0",
    "openai": "^6.25.0",
    "pg": "^8.20.0",
    "resend": "^6.12.3",
    "sqlite3": "^5.1.7",
    "stripe": "^14.25.0"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  }
}
